# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
secrets.json

# Local Databases & SQLite
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite3
database/*.db-wal
database/*.db-shm

# Generated Reports & Exported Forensic Artifacts
reports/*.pdf
reports/*.json
reports/*.csv
reports/*.rules
reports/*.spl
reports/*.zip
!reports/.gitkeep

# Unit Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

