# ==============================================================================
# SENTINEL-X | Vercel Deployment Ignore Configuration
# Prevents bloat, test scripts, local databases, and temporary files from
# uploading to Vercel Serverless Function build bundles.
# ==============================================================================

# Git & Vercel metadata
.git/
.gitignore
.vercel/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Local Secrets
.env
.env.*
secrets.json

# Local Databases (Keep serverless bundle small)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite3

# Generated Forensic PDF Reports & Exports
reports/*.pdf
reports/*.json
reports/*.csv
reports/*.rules
reports/*.spl
reports/*.zip
!reports/.gitkeep

# Unit Tests & Development Test Artifacts
test_app.py
tests/
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Documentation & Logs
*.log
logs/
